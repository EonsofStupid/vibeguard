{
  "$schema": "https://cloud.modelence.com/schema/modelence.config.json?version=1",
  "resources": {
    "app": {
      "type": "service",
      "image": "node-22-slim",
      "build": { "commands": ["npm ci", "npm run build"] },
      "start": { "commands": ["npm start"] }
    }
  },
  "env": {
    "VOYAGE_API_KEY": { "type": "secret", "required": false },
    "VOYAGE_MODEL": { "type": "text", "value": "voyage-code-4", "required": false }
  }
}
