# Copy to .env for a local Modelence run. Values are server-side only.
MONGODB_URI=mongodb+srv://<user>:<encoded-password>@<atlas-host>/vibeguard?authSource=admin&retryWrites=true&w=majority
VIBEGUARD_ATLAS_URI=mongodb+srv://<user>:<encoded-password>@<atlas-host>/vibeguard?authSource=admin&retryWrites=true&w=majority
VIBEGUARD_ATLAS_DATABASE=vibeguard
VIBEGUARD_MODEL_API_KEY=
VIBEGUARD_MODEL=gpt-5.6-luna
MONGODB_AGENTIC_CLIENT_ID=
MONGODB_AGENTIC_CLIENT_SECRET=
MONGODB_AGENTIC_PROJECT_ID=
MONGODB_AGENTIC_API_URL=https://agentengine.mongodb.com/api/v1/projects/<project-id>/workspaces/<workspace-id>/invoke
VIBEGUARD_MEMORY_MODE=hosted
VIBEGUARD_MEMORY_URL=https://agentengine.mongodb.com
VIBEGUARD_MEMORY_USER_ID=vibeguard-operator
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-4
