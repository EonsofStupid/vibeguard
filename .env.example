# Copy to .env. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@vibeguard.qyf6cd.mongodb.net/vibeguard?authSource=admin&retryWrites=true&w=majority
MONGODB_DATABASE=vibeguard
# Optional: direct hosts for networks that drop DNS SRV lookups (from Atlas "standard" connection string)
MONGODB_SEEDLIST=
MONGODB_REPLICA_SET=
VIBEGUARD_STORE=atlas
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://us.ai.mongodb.com/v1
VOYAGE_MODEL=voyage-code-4

# Atlas Agent Engine hosted memory (service account from `agentengine service-account create`)
MONGODB_AGENTIC_CLIENT_ID=
MONGODB_AGENTIC_CLIENT_SECRET=
AGENTIC_MEMORY_PROJECT_ID=
# VIBEGUARD_MEMORY=agentengine   # mirror the loop into the four hosted memory types
