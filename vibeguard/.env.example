# The full streaming endpoint for your workspace. This can also be a local invoke
# URL from `agentengine dev up`, which must use the playground UI port — the review
# queue and session history are not served on the orchestration engine port.
# Get deployed IDs with `agentengine projects list` and `agentengine workspace list`.
# https://agentengine.mongodb.com/api/v1/projects/<project id>/workspaces/<workspace id>/invokeStream
MONGODB_AGENTIC_API_URL=

# Deployed endpoints use a project service account. Create one with the
# AGENT_DEVELOPER role so it can invoke agents and resume executions.
# These credentials stay on the server and are exchanged for short-lived tokens.
MONGODB_AGENTIC_CLIENT_ID=
MONGODB_AGENTIC_CLIENT_SECRET=

# Role-specific targets used by ../tools/run-dashboard.ps1
# Chat points to VibeGuard; Review points to RRFlow.
VIBEGUARD_CHAT_API_URL=
RRFLOW_REVIEW_API_URL=

# Explicit model-only chat, before Agent Engine integration.
# Set the backend to model to enable it; there is no automatic fallback.
VIBEGUARD_CHAT_BACKEND=agentengine
VIBEGUARD_MODEL=gpt-5.6-luna
VIBEGUARD_MODEL_API_KEY=

# Atlas database connection, also used by Prisma.
# Replace DB_PASSWORD with the URL-encoded password for the Atlas database user.
MONGODB_URI="mongodb+srv://clyffy:<DB_PASSWORD>@vibeguard.qyf6cd.mongodb.net/vibeguard?authSource=admin&retryWrites=true&w=majority&appName=vibeguard"
